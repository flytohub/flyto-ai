# flyto-ai local configuration example.
# Copy to .env for local development only. Do not commit real secrets.

# Provider selection
FLYTO_AI_PROVIDER=openai
FLYTO_AI_MODEL=gpt-4o-mini
FLYTO_AI_BASE_URL=

# API keys. Set one provider key, or use FLYTO_AI_API_KEY for compatible APIs.
FLYTO_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Runtime limits and safety
FLYTO_AI_MAX_TOOL_ROUNDS=30
FLYTO_AI_PERMISSION_LEVEL=workspace_write
FLYTO_AI_ENABLE_INJECTION_DETECTION=true
FLYTO_AI_ENABLE_SANDBOX=false
FLYTO_AI_SANDBOX_IMAGE=flyto-sandbox:latest
FLYTO_AI_SANDBOX_TIMEOUT=60

# Memory, transcript, and vault storage
FLYTO_AI_ENABLE_MEMORY=true
FLYTO_AI_MEMORY_DB=~/.flyto/memory.db
FLYTO_AI_ENABLE_TRANSCRIPT=true
FLYTO_AI_TRANSCRIPT_DIR=~/.flyto/transcripts
FLYTO_AI_VAULT_PATH=~/.flyto/vault.enc
FLYTO_VAULT_PASSPHRASE=

# Optional HTTP server and browser settings
FLYTO_AI_SERVER_KEY=
FLYTO_AI_CORS_ORIGINS=http://localhost:3000
FLYTO_AI_KEEP_BROWSER=true

# Optional channel integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Enterprise/Flyto integrations
FLYTO_ENGINE_URL=http://localhost:8080
FLYTO_SERVICE_TOKEN=
FLYTO_AI_ENABLE_PRO=true
FLYTO_AI_ENABLE_EVOLUTION=false
